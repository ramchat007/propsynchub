# ==============================================================================
# PropSyncHub - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Project URL from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key for browser/client-side access (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Secret Service Role Key (SERVER-SIDE ONLY - NEVER expose to client)
# Used for administrative tasks, multi-tenant provisioning, and webhook processing
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# Razorpay Configuration (Test Mode)
# ------------------------------------------------------------------------------
# Razorpay Key ID (Safe to expose to client if using Razorpay checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Razorpay Key Secret (SERVER-SIDE ONLY - NEVER expose to client)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret for signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# Multi-Tenancy & Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TENANT_ID=default-tenant
